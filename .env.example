# Release identity
PP_RUNTIME_VERSION=1.0.0-rc.2

# Mini-program / online delivery should set PRODUCTION_FAST explicitly.
# Use VALIDATION for Golden calibration, regression and quality investigation.
PP_RUNTIME_MODE=PRODUCTION_FAST

PP_ARTIFACT_ROOT=artifacts
PP_GOLDEN_ROOT=goldens

# Vision / QC provider
PP_VISION_BASE_URL=https://api.siliconflow.cn/v1
PP_VISION_API_KEY=
PP_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Reference-edit image provider
PP_IMAGE_BASE_URL=https://yunwuapi.cc/v1
PP_IMAGE_API_KEY=
PP_IMAGE_MODEL=gpt-image-2

PP_REQUEST_TIMEOUT_SECONDS=120
PP_PRODUCTION_MAX_CREATIVE_RETRIES=1
PP_VALIDATION_MAX_CREATIVE_CYCLES=3
